# =============================================================================
# FinAlly — Environment Variables
# =============================================================================
# Copy this file to .env and fill in values as needed.
# The .env file is passed to the container via --env-file in the start scripts.
# All values are optional; the app runs in demo mode when keys are absent.
# =============================================================================

# Optional: OpenRouter API key for real LLM chat functionality.
# If missing, rate-limited, unavailable, or the provider call fails,
# the backend falls back to deterministic mock LLM responses.
OPENROUTER_API_KEY=

# Optional: OpenRouter model ID. Defaults to openrouter/openai/gpt-oss-120b
# (Cerebras inference via OpenRouter — fast, free-tier friendly).
OPENROUTER_MODEL=openrouter/openai/gpt-oss-120b

# Optional: Massive (Polygon.io) API key for real market data.
# If not set, the built-in market simulator is used (recommended for most users).
MASSIVE_API_KEY=

# Optional: Set to "false" to prefer real LLM calls when OPENROUTER_API_KEY
# is available. Defaults to true (mock mode on by default for fast local dev
# and free-tier safety).
LLM_MOCK=true

# Optional: SQLite database path inside the container.
# The named Docker volume finally-data is mounted at /app/db.
DB_PATH=/app/db/finally.db
